[Unit]
Description=Shipping Service

[Service]
User=roboshop
// highlight-start
Environment=CART_ENDPOINT={{ CART_HOST }}:8080
Environment=DB_HOST={{ MYSQL_HOST }}
// highlight-end
ExecStart=/bin/java -jar /app/{{ component }}.jar
SyslogIdentifier={{ component }}

[Install]
WantedBy=multi-user.target
